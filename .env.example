# ============================================================
#  环境变量示例
#  复制/参考此文件配置本地环境；真实值请勿提交到仓库。
#  后端本地开发可在 ~/.zshrc 或 backend/src/main/resources/application-local.yml 中配置。
# ============================================================

# --- 数据库 ---
# MySQL 密码（application.yml 读取 `${TANGENT_COMMON_PASSWORD:root}`）
TANGENT_COMMON_PASSWORD=your-db-password

# --- AI（DeepSeek）---
# 未配置时 /api/ai/status 返回 enabled=false，AI 功能自动禁用，其余功能正常
DEEPSEEK_API_KEY=your-deepseek-api-key
# 可选：
# DEEPSEEK_BASE_URL=https://api.deepseek.com
# DEEPSEEK_MODEL=deepseek-flash

# --- 部署（仅 docs/DEPLOYMENT.md 使用，代码不读取）---
# TANGENT_SERVER_IP=your-server-ip
